---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';
---

<!-- Barra fixa só no celular: o WhatsApp fica sempre a um toque -->
<div class="wa-bar">
  <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener">
    <Icon name="chat" />
    Falar no WhatsApp
  </a>
</div>

<style>
  .wa-bar {
    display: none;
  }

  @media (max-width: 900px) {
    .wa-bar {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: rgba(18, 17, 14, 0.96);
      border-top: 1px solid var(--line-dark);
    }

    .wa-bar .btn {
      width: 100%;
    }

    /* Espaço para a barra não cobrir o rodapé */
    :global(body) {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }
</style>
