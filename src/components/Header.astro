---
import Icon from './Icon.astro';
import { site, navLinks, whatsappLink } from '../data/site';
---

<header class="header" data-header>
  <div class="container header__inner">
    <a href="#inicio" class="header__logo" aria-label={`${site.name} — início`}>
      <img src="/logo.webp" alt={site.name} width="246" height="112" />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${site.phone.e164}`}>
        <Icon name="phone" size={18} />
        {site.phone.display}
      </a>
      <a class="btn btn--primary header__cta" href={whatsappLink()} target="_blank" rel="noopener">
        <Icon name="chat" size={18} />
        WhatsApp
      </a>
      <button
        type="button"
        class="header__toggle"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>Abrir menu</span>
        <Icon name="menu" size={22} class="icon-open" />
        <Icon name="close" size={22} class="icon-close" />
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="header__menu" hidden data-menu>
    <nav class="container" aria-label="Menu">
      <ul role="list">
        {navLinks.map((link) => (
          <li><a href={link.href} data-menu-link>{link.label}</a></li>
        ))}
      </ul>
      <div class="header__menu-actions">
        <a class="btn btn--primary btn--lg" href={whatsappLink()} target="_blank" rel="noopener">
          <Icon name="chat" />
          Falar no WhatsApp
        </a>
        <a class="btn btn--ghost btn--lg" href={`tel:${site.phone.e164}`}>
          <Icon name="phone" />
          Ligar {site.phone.display}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(18, 17, 14, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-dark);
  }

  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .header__logo img {
    height: 52px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 32px;
  }

  .header__nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #d9d3c6;
    text-decoration: none;
    padding: 8px 0;
    transition: color 0.2s ease;
  }

  .header__nav a:hover {
    color: var(--yellow);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--paper);
  }

  .header__phone :global(svg) {
    color: var(--yellow);
  }

  .header__cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }

  .header__toggle {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(244, 241, 234, 0.16);
    border-radius: var(--radius);
    color: var(--paper);
    cursor: pointer;
  }

  .header__toggle :global(.icon-close) {
    display: none;
  }

  .header__toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .header__toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .header__menu {
    border-top: 1px solid var(--line-dark);
    background: var(--ink);
    padding: 12px 0 28px;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }

  .header__menu ul a {
    display: block;
    padding: 16px 0;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--line-dark);
  }

  .header__menu-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 24px;
  }

  /* Tablet: some o telefone */
  @media (max-width: 1080px) {
    .header__phone {
      display: none;
    }
  }

  /* Celular / tablet pequeno: menu */
  @media (max-width: 900px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    :global(:root) {
      --header-h: 64px;
    }

    .header__logo img {
      height: 40px;
    }
  }

  @media (min-width: 901px) {
    .header__menu {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (label) label.textContent = open ? 'Fechar menu' : 'Abrir menu';
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
